{
  "name": "unpopping-candy-design",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.4.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "pnpm --recursive --filter './packages/**' build && pnpm --filter @unpopping-candy/playground build && pnpm --filter @unpopping-candy/agent-lab build && pnpm --filter @unpopping-candy/consumer-fixture build && pnpm --filter @unpopping-candy/docs build-storybook",
    "build:packages": "pnpm --recursive --filter './packages/**' build",
    "bundle:check": "node scripts/verify-bundle-budgets.mjs",
    "changeset": "changeset",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm --parallel --filter @unpopping-candy/playground --filter @unpopping-candy/docs --filter @unpopping-candy/agent-lab dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "release:candidate": "node scripts/prepare-release-candidate.mjs",
    "test": "pnpm test:pure && pnpm verify",
    "test:storybook": "pnpm --filter @unpopping-candy/docs test -- --run",
    "test:browser": "playwright test",
    "test:pure": "node --experimental-strip-types --test packages/*/test/*.test.ts && node --test tests/architecture/*.test.mjs",
    "typecheck": "pnpm --recursive typecheck",
    "verify": "npm run agent:check && npm run ai:check && node scripts/verify-package-contracts.mjs && node scripts/verify-boundaries.mjs && node scripts/verify-exports.mjs && node scripts/verify-css-contract.mjs && node scripts/verify-docs.mjs && node scripts/verify-registry-templates.mjs && tsc -p tsconfig.syntax.json",
    "version-packages": "changeset version",
    "preview:capture": "python3 scripts/capture-static-preview.py",
    "knowledge:generate": "node --experimental-strip-types scripts/generate-knowledge.mjs",
    "knowledge:check": "node --experimental-strip-types scripts/generate-knowledge.mjs --check",
    "agent:generate": "npm run knowledge:generate && npm run registry:generate && npm run stories:generate && node --experimental-strip-types scripts/generate-agent-docs.mjs && npm run skills:generate && npm run evals:generate && npm run figma:generate",
    "agent:check": "npm run knowledge:check && npm run registry:check && npm run stories:check && node --experimental-strip-types scripts/generate-agent-docs.mjs --check && npm run skills:check && npm run evals:check && npm run figma:check",
    "popcandy": "node --experimental-strip-types packages/cli/src/bin.ts",
    "skills:generate": "node scripts/verify-skills.mjs --write",
    "skills:check": "node scripts/verify-skills.mjs --check",
    "mcp:dev": "node --experimental-strip-types packages/mcp/src/stdio.ts",
    "registry:generate": "node --experimental-strip-types scripts/generate-registry.mjs",
    "registry:check": "node --experimental-strip-types scripts/generate-registry.mjs --check",
    "stories:generate": "node --experimental-strip-types scripts/verify-story-manifest.mjs",
    "stories:check": "node --experimental-strip-types scripts/verify-story-manifest.mjs --check",
    "evals:generate": "node --experimental-strip-types scripts/generate-agent-evals.mjs",
    "evals:check": "node --experimental-strip-types scripts/generate-agent-evals.mjs --check",
    "evals:plan": "node --experimental-strip-types scripts/run-model-evals.mjs plan",
    "evals:run": "node --experimental-strip-types scripts/run-model-evals.mjs run",
    "evals:report": "node --experimental-strip-types scripts/run-model-evals.mjs report",
    "figma:generate": "node --experimental-strip-types scripts/generate-figma.mjs",
    "figma:check": "node --experimental-strip-types scripts/generate-figma.mjs --check",
    "figma:publish-check": "node --experimental-strip-types scripts/generate-figma.mjs --publish-check",
    "figma:parse": "figma connect parse --config figma.config.json",
    "figma:preview": "figma connect preview --config figma.config.json",
    "figma:publish": "npm run figma:publish-check && figma connect publish --config figma.config.json",
    "fixtures:compat": "node scripts/run-compatibility-matrix.mjs",
    "ai:check": "node scripts/verify-ai-contracts.mjs",
    "release:check": "node scripts/verify-release-readiness.mjs"
  },
  "devDependencies": {
    "@babel/parser": "7.29.8",
    "@babel/types": "7.29.8",
    "@changesets/cli": "2.29.7",
    "@playwright/test": "1.62.1",
    "@storybook/addon-vitest": "10.5.0",
    "@types/node": "24.3.0",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "10.7.0",
    "prettier": "3.6.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10",
    "@figma/code-connect": "1.5.0"
  }
}
