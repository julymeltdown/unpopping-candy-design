{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "color": {
    "reference": {
      "neutral0": { "$type": "color", "$value": "#ffffff" },
      "neutral50": { "$type": "color", "$value": "#f7f7f5" },
      "neutral100": { "$type": "color", "$value": "#f1f1ee" },
      "neutral200": { "$type": "color", "$value": "#dfdfda" },
      "neutral300": { "$type": "color", "$value": "#c8c8c1" },
      "neutral600": { "$type": "color", "$value": "#666661" },
      "neutral950": { "$type": "color", "$value": "#161616" },
      "blue500": { "$type": "color", "$value": "#0f62fe" },
      "green600": { "$type": "color", "$value": "#198754" },
      "amber700": { "$type": "color", "$value": "#9a6700" },
      "red600": { "$type": "color", "$value": "#c9362b" }
    },
    "semantic": {
      "canvas": { "$type": "color", "$value": "{color.reference.neutral50}" },
      "surface": { "$type": "color", "$value": "{color.reference.neutral0}" },
      "text": { "$type": "color", "$value": "{color.reference.neutral950}" },
      "textMuted": { "$type": "color", "$value": "{color.reference.neutral600}" },
      "border": { "$type": "color", "$value": "{color.reference.neutral200}" },
      "action": { "$type": "color", "$value": "{color.reference.blue500}" },
      "positive": { "$type": "color", "$value": "{color.reference.green600}" },
      "warning": { "$type": "color", "$value": "{color.reference.amber700}" },
      "critical": { "$type": "color", "$value": "{color.reference.red600}" }
    }
  },
  "dimension": {
    "button": {
      "heightSmall": { "$type": "dimension", "$value": { "value": 32, "unit": "px" } },
      "heightMedium": { "$type": "dimension", "$value": { "value": 40, "unit": "px" } },
      "heightLarge": { "$type": "dimension", "$value": { "value": 48, "unit": "px" } }
    }
  }
}
