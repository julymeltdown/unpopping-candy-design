{
  "name": "@commonspace/ui",
  "version": "0.1.0",
  "description": "Accessible, product-independent React components for Commonspace.",
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist", "README.md"],
  "sideEffects": ["./dist/styles.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./alert": { "types": "./dist/alert.d.ts", "import": "./dist/alert.js" },
    "./avatar": { "types": "./dist/avatar.d.ts", "import": "./dist/avatar.js" },
    "./badge": { "types": "./dist/badge.d.ts", "import": "./dist/badge.js" },
    "./button": { "types": "./dist/button.d.ts", "import": "./dist/button.js" },
    "./dialog": { "types": "./dist/dialog.d.ts", "import": "./dist/dialog.js" },
    "./feedback": { "types": "./dist/feedback.d.ts", "import": "./dist/feedback.js" },
    "./forms": { "types": "./dist/forms.d.ts", "import": "./dist/forms.js" },
    "./layout": { "types": "./dist/layout.d.ts", "import": "./dist/layout.js" },
    "./loading": { "types": "./dist/loading.d.ts", "import": "./dist/loading.js" },
    "./tabs": { "types": "./dist/tabs.d.ts", "import": "./dist/tabs.js" },
    "./styles.css": "./dist/styles.css"
  },
  "publishConfig": { "access": "public" },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {
    "@commonspace/icons": "workspace:^",
    "@commonspace/tokens": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.1.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/copy-package-assets.mjs . src/styles.css dist/styles.css",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
