{
  "name": "@commonspace/mcp",
  "version": "0.2.0",
  "description": "Read-only MCP resources, tools, and prompts for Commonspace UI design-system knowledge.",
  "license": "UNLICENSED",
  "type": "module",
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "bin": { "commonspace-mcp": "./dist/stdio.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@commonspace/cli": "workspace:^",
    "@commonspace/knowledge": "workspace:^",
    "@commonspace/tokens": "workspace:^",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": { "@types/node": "24.3.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
