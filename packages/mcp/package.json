{
  "name": "@unpopping-candy/mcp",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/julymeltdown/unpopping-candy-design.git",
    "directory": "packages/mcp"
  },
  "description": "MCP resources, bounded discovery tools, validation, and guarded registry actions for Unpopping Candy.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "bin": {
    "popcandy-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unpopping-candy/cli": "workspace:^",
    "@unpopping-candy/knowledge": "workspace:^",
    "@unpopping-candy/tokens": "workspace:^",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.4.3",
    "@unpopping-candy/registry": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "24.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
