{
  "name": "@unpopping-candy/cli",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/julymeltdown/unpopping-candy-design.git",
    "directory": "packages/cli"
  },
  "description": "Deterministic project detection, design-system discovery, composition planning, and validation for Unpopping Candy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.13.0 <23 || >=24 <25"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "bin": {
    "popcandy": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@unpopping-candy/knowledge": "workspace:^",
    "@unpopping-candy/registry": "workspace:^",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
