{
  "name": "@unpopping-candy/theme",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/julymeltdown/unpopping-candy-design.git",
    "directory": "packages/theme"
  },
  "description": "Theme and density scoping for Unpopping Candy.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18.3 <20",
    "react-dom": ">=18.3 <20"
  },
  "dependencies": {
    "@unpopping-candy/tokens": "workspace:^"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "vite": "8.1.0"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
