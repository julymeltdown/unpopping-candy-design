{
  "$schema": "./schemas/popcandy-config.schema.json",
  "schemaVersion": 1,
  "catalog": "./agent/manifests/catalog.json",
  "design": "./DESIGN.md",
  "llms": {
    "index": "./agent/llms.txt",
    "small": "./agent/llms-small.txt",
    "full": "./agent/llms-full.txt",
    "components": "./agent/llms-components.txt",
    "patterns": "./agent/llms-patterns.txt",
    "tokens": "./agent/llms-tokens.txt",
    "migrations": "./agent/llms-migrations.txt"
  },
  "registry": "./agent/manifests/registry.json",
  "skills": "./agent/manifests/skills.json",
  "stories": {
    "manifest": "./agent/manifests/stories.json",
    "storybookUrl": "http://localhost:6006",
    "mcpUrl": "http://localhost:6006/mcp"
  },
  "evaluations": "./agent/manifests/evals.json",
  "figma": "./agent/manifests/figma.json",
  "styles": [
    "@unpopping-candy/tokens/styles.css",
    "@unpopping-candy/icons/styles.css",
    "@unpopping-candy/ui/styles.css",
    "@unpopping-candy/social/styles.css"
  ],
  "validation": {
    "exclude": [
      "agent/**",
      "docs/**",
      "figma/**",
      "scripts/**",
      "tests/**",
      "**/test/**",
      "**/*.test.ts",
      "**/*.test.tsx",
      "packages/knowledge/src/generated/**",
      "packages/evals/src/reference-scenarios.ts"
    ],
    "allowedEntrypoints": [
      "@unpopping-candy/knowledge",
      "@unpopping-candy/registry",
      "@unpopping-candy/cli",
      "@unpopping-candy/mcp",
      "@unpopping-candy/evals",
      "@unpopping-candy/figma",
      "@unpopping-candy/eval-report"
    ]
  }
}
